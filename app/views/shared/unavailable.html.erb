<h1 class="text-2xl font-bold mb-4">Resource unavailable</h1>
<div class="rounded-lg border border-red-200 bg-white p-5 text-sm space-y-2">
  <p>This page needs a resource that is missing or unreachable. Check the <%= link_to "dashboard", root_path, class: "underline" %> for details.</p>
  <p class="font-mono text-red-800 break-all"><%= exception.class %>: <%= exception.message %></p>
</div>
