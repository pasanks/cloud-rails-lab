<h1 class="text-2xl font-bold mb-1">Cache</h1>
<p class="text-sm text-gray-600 mb-6">Rails cache store: <strong><%= @store %></strong>.
  <% if ENV["REDIS_URL"].blank? %>REDIS_URL is not set, so each process keeps its own in-memory count.<% end %></p>

<div class="rounded-lg border border-gray-200 bg-white p-5 mb-4">
  <p class="text-sm text-gray-500">Page views counted in the cache</p>
  <p class="text-4xl font-bold"><%= @hits || "?" %></p>
  <% if @hits.nil? %><p class="text-sm text-red-700 mt-2">The cache could not be reached, so nothing was counted. Check the logs.</p><% end %>
</div>

<%= button_to "Reset counter", cache_path, method: :delete, class: "text-sm text-red-600 hover:underline cursor-pointer" %>
